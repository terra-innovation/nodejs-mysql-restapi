# Valores publicos y sinteticos para las pruebas rapidas en GitHub Actions.
# La base y APIs apuntan a un puerto local cerrado; no son servicios reales.
WEB_SITE=http://127.0.0.1
TOKEN_KEY_JWT=ci-synthetic-jwt
TOKEN_KEY_OTP=ci-synthetic-otp
MAIL_ENCRYPTION_KEY_COFIG=ci-synthetic-mail
TELEGRAM_ACTIVE=false
TELEGRAM_IMPORTANT_TOKEN=synthetic
TELEGRAM_IMPORTANT_CHATID=synthetic
TELEGRAM_IMFORMATION_TOKEN=synthetic
TELEGRAM_IMFORMATION_CHATID=synthetic
TELEGRAM_WARING_TOKEN=synthetic
TELEGRAM_WARRING_CHATID=synthetic
TELEGRAM_ERROR_TOKEN=synthetic
TELEGRAM_ERROR_CHATID=synthetic
PRISMA_DATABASE_FACTORING_NICKNAME=ci-quick-no-database
PRISMA_DATABASE_FACTORING_URL=mysql://synthetic:synthetic@127.0.0.1:1/ci_quick_unused
PRISMA_DATABASE_FACTORING_TRANSACTION_TIMEOUT=10000
PRISMA_DATABASE_FACTORING_SLOW_QUERY_THRESHOLD=200
PRISMA_DATABASE_FACTORING_LOG_QUERY=false
PRISMA_DATABASE_FACTORING_LOG_INFO=false
PRISMA_DATABASE_FACTORING_LOG_WARN=false
PRISMA_DATABASE_FACTORING_LOG_ERROR=false
PRISMA_DATABASE_FACTORING_LOG_SLOW_QUERIES=false
LOG_LEVEL_CONSOLE=silent
LOG_LEVEL_FILE=silent
DECOLECTA_BASE_URL=http://127.0.0.1:1
DECOLECTA_API_TOKEN=synthetic
APISPERU_BASE_URL=http://127.0.0.1:1
