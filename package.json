{
  "name": "ft-app-backend",
  "version": "1.0.1",
  "private": true,
  "description": "A powerfull REST API with Node.js, Express and MySQL",
  "main": "dist/src/index.js",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:vitest": "npm run test:vitest:typecheck",
    "typecheck:integration": "npm run test:integration:typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:vitest && npm run typecheck:integration",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:changed": "node scripts/quality/format-changed.mjs --check",
    "format:changed:write": "node scripts/quality/format-changed.mjs --write",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"tests/**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"*.{json,js,mjs,cjs}\"",
    "build_anterior": "tsc",
    "prebuild": "npm run prisma:generate",
    "build": "tsc --noEmit && tsdown",
    "dev": "cross-env TZ=UTC tsx watch --tsconfig ./tsconfig.json  src/index.ts",
    "start": "node dist/index.js",
    "test": "cross-env TZ=UTC NODE_ENV=test vitest run --config vitest.config.ts",
    "test:vitest": "cross-env TZ=UTC NODE_ENV=test vitest run --config vitest.config.ts",
    "test:vitest:unit": "npm run test:vitest -- tests/vitest/unit",
    "test:vitest:http": "npm run test:vitest -- tests/vitest/http",
    "test:vitest:watch": "cross-env TZ=UTC NODE_ENV=test vitest --config vitest.config.ts",
    "test:vitest:coverage": "cross-env TZ=UTC NODE_ENV=test vitest run --config vitest.config.ts --coverage",
    "test:vitest:ci": "cross-env CI=true TZ=UTC NODE_ENV=test vitest run --config vitest.config.ts --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/vitest/junit.xml",
    "test:vitest:typecheck": "tsc --project tests/vitest/tsconfig.json --noEmit",
    "test:all": "npm run test:vitest:typecheck && npm test",
    "test:integration:schema": "node scripts/integration/export-schema.mjs",
    "audit:factoring:historical": "node scripts/integration/audit-historical-factoring.mjs",
    "test:integration:doctor": "node scripts/integration/doctor.mjs",
    "test:integration": "node scripts/integration/run-mariadb.mjs",
    "test:runtime": "node scripts/integration/run-mariadb.mjs tests/mariadb/runtime.test.ts",
    "test:integration:typecheck": "tsc --project tests/mariadb/tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:generate:ci": "cross-env NODE_ENV=production prisma generate",
    "prisma-sync": "node scripts/prisma/generate-models.js",
    "list-unused-exports": "powershell -Command \"npx ts-prune | Select-String -NotMatch 'used in module' | Select-String '\\\\src\\\\controllers\\\\'\"",
    "build-prod": "node scripts/produccion/build-prod.js",
    "cron:tipo-cambio": "cross-env NODE_ENV=development node --env-file=.env.development --import tsx/esm src/scripts/sync_tipo_cambio.ts",
    "cron:tipo-cambio:prod": "node dist/scripts/sync_tipo_cambio.js",
    "cron:email-venta-frio": "cross-env NODE_ENV=development tsx src/scripts/email_venta_frio.ts",
    "cron:email-venta-frio:prod": "node dist/scripts/email_venta_frio.js"
  },
  "imports": {
    "#root/*": "./*",
    "#src/*": "./src/*"
  },
  "env": {
    "TZ": "UTC"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.20.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "html-to-text": "10.0.1",
    "ip-range-check": "0.2.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mariadb": "3.4.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "0.20.2",
    "pdfkit-table": "0.2.11",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "pino-roll": "4.0.0",
    "rate-limiter-flexible": "11.2.1",
    "uuid": "14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml2js": "0.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "cross-env": "10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "pdfjs-dist": "6.4.299",
    "pluralize-esm": "^9.0.5",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-prune": "^0.10.3",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
